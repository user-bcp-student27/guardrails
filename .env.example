# S4 Guardrails — clona un repo y abre el PR con `gh` CLI.
# mcp_git.py sólo se importa para set_verbose().

# ── LLM — GitHub Copilot SDK ───────────────────────────────────────
COPILOT_MODEL=gpt-6-luna
COPILOT_REASONING_EFFORT=high
COPILOT_USE_LOGGED_IN_USER=true

# Copiar este archivo como .env. NUNCA commitear .env.

# ── MCP Git opcional — cliente conservado del laboratorio (puerto 8082) ────────────────
# main.py usa gh para el PR y no requiere este servicio.
GIT_MCP_URL=http://localhost:8082
# MCP_GIT_URL es un alias de compatibilidad: mcp_git.py lo consulta
# sólo si GIT_MCP_URL no está definida. No hace falta fijarlo.
MCP_TIMEOUT=60
MCP_VERBOSE=false                  # true → log interno del cliente MCP

# ── Repositorio a clonar y refactorizar ──────────────────────────
GITHUB_OWNER=<OWNER>            # tu owner: el mismo de los Días 1-3
GITHUB_REPO=workshop-requirements-api
# Issue del Project ReqFlow en alcance (Día 3 lo dejó en Todo). El harness
# lo lee con `gh issue view` y el PR lo cierra con "Closes #N".
GITHUB_ISSUE=
GIT_BASE_BRANCH=main
GIT_HEAD_BRANCH=feature/equipo-XX/workshop-refactor

# Token sólo si el repo es privado (se embebe en la URL de clone)
# GITHUB_TOKEN=ghp-xxxxxxxxxxxxxxxxxxxx

# ── Repos ReqFlow por componente (los lee mcp_git.py) ────────────
FRONTEND_REPO=workshop-login-frontend
BACKEND_REPO=workshop-auth-backend
API_REPO=workshop-requirements-api

# ── Review loop ──────────────────────────────────────────────────
MAX_REVIEW_ROUNDS=3

# ── Evals de contrato (evals/contract_evals.py, suite aparte) ────
# Requieren los servicios levantados. main.py no las usa.
BACKEND_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8000
HTTP_TIMEOUT=30
TEST_USER=student                 # usuario del Día 1
TEST_USER_PASSWORD=Workshop123!
LOGIN_USER_FIELD=username

# Solo el grupo de siete activa Datos y persistencia.
GUARDRAILS_INCLUDE_DATA=false
